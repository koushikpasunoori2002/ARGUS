{
  "synchronization": {
    "enabled": true,
    "default_interval_seconds": 60,
    "scheduler_check_interval_seconds": 1
  },
  "log_types": {
    "auth": {
      "parser": "AuthParser"
    },
    "syslog": {
      "parser": "SyslogParser"
    },
    "kern": {
      "parser": "KernParser"
    },
    "dpkg": {
      "parser": "DpkgParser"
    },
    "dmesg": {
      "parser": "DmesgParser"
    }
  }
}